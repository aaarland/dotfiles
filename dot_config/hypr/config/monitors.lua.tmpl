-- Monitor wiki https://wiki.hypr.land/Configuring/Basics/Monitors/
-- Example: output can be found with hyprctl monitors. Edit variables.lua for the monitor outputs instead of here directly
{{- if eq .chezmoi.hostname "linux-beast" }}

-- Dual 1440p, stacked: DP-1 (120Hz) on top, DP-2 (180Hz) below
hl.monitor({ output = "DP-1",     mode = "2560x1440@120", position = "0x0",    scale = "1" })
hl.monitor({ output = "DP-2",     mode = "2560x1440@179.95", position = "0x1440", scale = "1" })
-- HDMI-A-1: no Lua equivalent of the old "monitor=...,disabled" — if it's connected,
-- toggle-hdmi.sh manages it, and it will auto-join until toggled.
{{- else }}

hl.monitor({
    output    = MONITOR1,
    mode      = "preferred",
    position  = "auto",
    scale     = "auto",
})
{{- end }}
