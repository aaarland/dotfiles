FILE_MANAGER = "dolphin"
BROWSER      = "firefox"
EDITOR       = "alacritty -e nvim"
CALCULATOR   = "gnome-calculator"

-- Monitors
{{- if eq .chezmoi.hostname "linux-beast" }}
MONITOR1 = "DP-1"
MONITOR2 = "DP-2"
